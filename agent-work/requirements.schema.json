{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature requirements manifest",
  "type": "object",
  "required": [
    "feature",
    "requirements"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "design_document": {
      "type": "string"
    },
    "baseline_commit": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "category",
          "priority",
          "source",
          "verification",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "test_written",
              "implemented",
              "verified",
              "blocked",
              "deferred"
            ]
          },
          "source": {
            "type": "object",
            "description": "Where the requirement comes from. 'explicit' is stated in the design and must quote it verbatim; 'inferred' follows from the design but is not stated; 'assumption' fills a gap the design leaves open. Inferred and assumption requirements need human sign-off.",
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "explicit",
                  "inferred",
                  "assumption"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "Design section or heading, e.g. '\u00a73.2 Tenant isolation'."
              },
              "quote": {
                "type": "string",
                "description": "Verbatim excerpt from the design document."
              },
              "rationale": {
                "type": "string",
                "description": "Why the requirement follows from, or is needed despite, the design."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "explicit"
                    }
                  }
                },
                "then": {
                  "required": [
                    "quote"
                  ],
                  "properties": {
                    "quote": {
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "inferred",
                        "assumption"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "rationale"
                  ],
                  "properties": {
                    "rationale": {
                      "minLength": 1
                    }
                  }
                }
              }
            ],
            "additionalProperties": true
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "description"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "test_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
